# Silent Handover API — copy to backend/.env (never commit the real file).
# Every value has a safe local default; nothing here is required to run the local demo.

# ---- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=8787
# Where the web app is served (used in email links) and where this API is reachable.
APP_BASE_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8787
CORS_ORIGINS=http://localhost:5173

# ---- Mode --------------------------------------------------------------------
# local    = embedded PostgreSQL (PGlite) + local test accounts. Development only.
# supabase = Supabase PostgreSQL + Supabase Auth.
APP_MODE=local
# LOCAL_DB_DIR=./.data
# Signs local sign-in tokens (32+ characters). Local mode creates one in the data folder when unset.
# LOCAL_JWT_SECRET=
# Apply new database migrations when the API starts (default true).
# MIGRATE_ON_START=true
# Seeds synthetic demo accounts (listed in the README) and enables demo tools (local mode only).
DEMO_MODE=true

# ---- Supabase (APP_MODE=supabase) ---------------------------------------------
# Use the connection pooler URL with the postgres role.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=           # public; the browser uses it to sign in
# SUPABASE_SERVICE_ROLE_KEY=   # secret; only used to create users
# SUPABASE_JWT_SECRET=         # optional legacy HS256 secret; otherwise JWKS is used

# ---- AI processing -----------------------------------------------------------------
# admin = the provider (Google Gemini or xAI Grok) and API key the administrator saves on the
#         admin Integrations page; the labeled simulator runs until then. Keys are never put here.
# dev   = always the local simulator (no AI is called). n8n = Workflow A.
AI_ADAPTER=admin
AI_REQUEST_TIMEOUT_MS=60000
# Mica assistant requests allowed per person per minute.
MICA_REQUESTS_PER_MINUTE=20
# Encrypts secrets saved in the app (the AI key): 32 random bytes, e.g. openssl rand -base64 32.
# Required in Supabase mode to save a key; local mode creates one in the local data folder.
# SECRETS_ENCRYPTION_KEY=
PROMPT_VERSION=1.0
DEV_ANALYSIS_DELAY_MS=1500
# N8N_ANALYSIS_WEBHOOK_URL=https://n8n.example.com/webhook/silent-handover-analysis
# N8N_DELIVERY_WEBHOOK_URL=https://n8n.example.com/webhook/silent-handover-delivery
# Shared secrets, at least 24 characters each (openssl rand -base64 36):
# N8N_WEBHOOK_SECRET=          # API → n8n (header X-Silent-Handover-Secret)
# N8N_CALLBACK_SECRET=         # n8n → API (Authorization: Bearer ...)
N8N_REQUEST_TIMEOUT_MS=10000

# ---- Email ---------------------------------------------------------------------------
# Normally set up in the app instead: Integrations -> Email -> Connect Gmail (an App Password,
# stored encrypted) or Resend. That choice overrides this setting without a restart.
# dev = recorded in the admin dev outbox as "simulated"; nothing is sent.
# APP_BASE_URL (above) is where invitation links point: set it to the address people open.
EMAIL_TRANSPORT=dev
# RESEND_API_KEY=re_...
EMAIL_FROM=Silent Handover <handover@example.com>

# Gmail from the environment (for a brand-new hosted server, to email the first administrator):
# EMAIL_TRANSPORT=gmail
# GMAIL_USER=yourteam@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ---- First administrator (a real organization, no demo data) ----------------------------
# Invited by email on first start; they choose their own password and add everyone else.
# FIRST_ADMIN_EMAIL=you@example.com
# FIRST_ADMIN_NAME=Your Name

# ---- Optional SMS -------------------------------------------------------------------
# none = SMS delivery rows are honestly marked skipped. n8n = dedicated SMS workflow.
SMS_TRANSPORT=none
# N8N_SMS_WEBHOOK_URL=https://n8n.example.com/webhook/silent-handover-sms
SMS_FROM=Silent Handover

# ---- Background work ----------------------------------------------------------------
# Disable when the API runs serverless and n8n Workflow C calls /api/integrations/n8n/tick instead.
ENABLE_INTERNAL_SCHEDULER=true
SCHEDULER_INTERVAL_MS=30000
